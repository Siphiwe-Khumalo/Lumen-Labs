# Copy this file to .env and fill it in. Never commit .env.

# From https://platform.claude.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Passcode for the lock screen. Required when deployed (npm start); optional locally.
LUMEN_PASSCODE=

# Optional: stop answering once this many US dollars are spent in a day (0 = no cap).
LUMEN_DAILY_BUDGET_USD=3

# Optional: helps local answers (weather, news, "near me").
LUMEN_HOME_CITY=Johannesburg
LUMEN_HOME_REGION=Gauteng
LUMEN_HOME_COUNTRY=ZA
LUMEN_HOME_TIMEZONE=Africa/Johannesburg

# Models. Quick mode uses Sonnet (fast, half the price); Deep research and briefings use Opus.
# Change these only if you want to. claude-haiku-5-5 is the fastest and cheapest option for Quick.
LUMEN_QUICK_MODEL=claude-sonnet-5-5
# LUMEN_MODEL=claude-opus-5-5
