{
  "name": "lumen-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lumen — a voice-first AI assistant with a live HUD, powered by Claude.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "demo": "tsx server/index.ts --demo",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
