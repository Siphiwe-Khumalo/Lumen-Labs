{
  "name": "lumen-labs-launch-film",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lumen Labs launch brand film — code-driven Remotion motion-graphics composition (9:16).",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still",
    "render": "remotion render LaunchFilm-Vertical out/lumen-labs-launch-9x16.mp4",
    "render:film": "remotion render BrandFilm out/lumen-labs-brand-film.mp4 --binaries-directory=\"$(bash scripts/setup-render-binaries.sh)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fonts": "bash scripts/copy-fonts.sh"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.1.1",
    "@fontsource-variable/manrope": "5.1.1",
    "@fontsource-variable/space-grotesk": "5.1.1",
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
